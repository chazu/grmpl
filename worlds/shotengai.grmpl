package kasumi_shotengai bootstrap 1

entity PLAYER = 1
entity WORLD = 2
entity EAST_GATE = 10
entity ARCADE = 11
entity KISSATEN = 12
entity REPAIR_SHOP = 13
entity SENTO = 14
entity COOPERATIVE = 15
entity SHRINE_ALLEY = 16
entity CINEMA = 17
entity ROOFTOP = 18
entity RED_UMBRELLA = 20
entity BRASS_TOKEN = 21
entity OLD_RADIO = 22
entity TEA_TIN = 23
entity CAT = 30
entity PROPRIETOR = 31
entity REPAIRER = 32
entity CARETAKER = 33
entity COMBAT = 34
entity COURIER = 100
entity COOK = 101
entity REPAIRER_JOB = 102
entity SHRINE_ATTENDANT = 103
entity NIGHT_WATCH = 104
entity QUICK_STEP = 200
entity SEARING_PAN = 201
entity LIVE_WIRE = 202
entity PAPER_WARD = 203
entity LANTERN_WALL = 204
entity DUNGEON_ENTRY = 1000
entity FLOODED_STORE = 1001
entity FORGOTTEN_ARCADE = 1002
entity LEDGER_VAULT = 1003
entity MIRROR_CHAMBER = 1004
entity MANNEQUIN_STOCKROOM = 1005
entity RECEIPT_MOTH = 1010
entity SHUTTER_MAW = 1011
entity LAST_CUSTOMER = 1012
entity MANNEQUIN_SHELL = 1013
entity DUNGEON_COIN = 1020
entity RED_THREAD = 1021
entity COPYING_MIRROR = 1022

requires random omens(state: rng_state, owner: WORLD, algorithm: xorshift64star_v1)
requires schedule world_clock(clock: clock, timers: timers, sequences: inbox_seq)

// ============================================================================
// Kasumi Shotengai — a larger MOO world whose rules live on grmpl's relational
// surface. Initial places, people, finite combat tables, and dungeon templates
// are data seeded by the edge host.
// ============================================================================

// ---- ordinary world ---------------------------------------------------------
rel located(thing: Ent, place: Ent)
rel named(thing: Ent, name: Text)
rel described(thing: Ent, text: Text)
rel held(owner: Ent, thing: Ent)
rel exits(from: Ent, way: Text, to: Ent)
rel players(who: Ent, name: Text)
rel value(thing: Ent, coins: Int)

rel person(thing: Ent)
rel label(thing: Ent, text: Text)
rel knows(viewer: Ent, thing: Ent)
rel patrol(from: Ent, to: Ent)
rel job_clock(place: Ent)

// ---- jobs and combat --------------------------------------------------------
rel job(which: Ent, name: Text)
rel active_job(player: Ent, job: Ent)
rel job_rank(player: Ent, job: Ent, rank: Int)
rel job_points(player: Ent, job: Ent, points: Int)
rel job_stats(job: Ent, rank: Int, power: Int, guard: Int, max_hp: Int)
rel job_progression(job: Ent, old_rank: Int, old_points: Int, reward: Int,
                    new_rank: Int, new_points: Int, ability: Ent,
                    old_ability_rank: Int, new_ability_rank: Int)

rel ability(which: Ent, name: Text)
rel ability_rank(player: Ent, ability: Ent, rank: Int)
rel ability_power(ability: Ent, rank: Int, power: Int)

rel monster(thing: Ent)
rel hp(thing: Ent, current: Int)
rel defense(thing: Ent, guard: Int)
rel monster_power(thing: Ent, power: Int)
rel monster_reward(thing: Ent, points: Int)
rel defeated(thing: Ent)
rel combat_event(player: Ent, monster: Ent, outcome: Text)
rel combat_claimed(monster: Ent, claimed: Bool)
rel player_defeat(player: Ent)
rel boss_unlock(monster: Ent, boss: Bool, vault: Ent, chamber: Ent)

// ---- durable edge/runtime state --------------------------------------------
rel session_branch(player: Ent, branch: Int)
rel echo_depth(world: Ent, depth: Int)
rel instance_state(player: Ent, shift: Int, home: Ent)
rel instance_counter(player: Ent, next: Int)
rel rng_state(owner: Ent, state: Int)
rel clock(seq: Int, wall_ms: Int, random: Int)
rel timers(due: Int, inbox: Int, target: Ent, body: Tuple)
rel patrol_due(actor: Ent, due: Int)

// ---- card table: arithmetic and combinations are relations -----------------
rel card(holder: Ent, slot: Int, code: Int)
rel cardval(code: Int, pips: Int)
rel cardrank(code: Int, rank: Int)
rel slotpair(i: Int, j: Int)
rel slottrio(i: Int, j: Int, k: Int)
rel sum15two(a: Int, b: Int)
rel sum15three(a: Int, b: Int, c: Int)

// ---- process and watch plumbing --------------------------------------------
rel tell(player: Ent, text: Text)
rel inbox(process: Ent, seq: Int, body: Tuple)
rel patrol_inbox(process: Ent, seq: Int, body: Tuple)
rel combat_inbox(process: Ent, seq: Int, body: Tuple)
rel inbox_seq(process: Ent, next: Int)
rel cursor(process: Ent, pos: Int)

authority player_writes {
    write active_job
    write combat_event
    write cursor
    write held
    write hp
    write knows
    write located
    write rng_state
    write tell
    write timers
}

authority patrol_writes {
    write cursor
    write located
    write patrol_due
    write timers
}

authority combat_writes {
    write ability_rank
    write combat_claimed
    write combat_event
    write cursor
    write defeated
    write exits
    write hp
    write job_points
    write job_rank
    write monster_reward
    write player_defeat
    write tell
}

actor PLAYER { inbox inbox cursor cursor authority player_writes }
actor CAT { inbox patrol_inbox cursor cursor authority patrol_writes }
actor COMBAT { inbox combat_inbox cursor cursor authority combat_writes }
rel wmail(who: Ent, seq: Int, body: Tuple)
rel wcursor(watch: Ent, edition: Int)
rel wseq(inbox: Int, target: Ent, n: Int)

// ---- base views -------------------------------------------------------------
view here(viewer) {
    located(viewer, room)
    located(thing, room)
    named(thing, name)
    yield thing, name
}

view contents(viewer) {
    located(viewer, room)
    located(thing, room)
    yield thing
}

view inventory(owner) {
    held(owner, thing)
    named(thing, name)
    yield thing, name
}

view whereami(viewer) {
    located(viewer, room)
    named(room, name)
    yield room, name
}

view ways(viewer) {
    located(viewer, room)
    exits(room, way, destination)
    yield way, destination
}

view roster() {
    players(who, name)
    yield who, name
}

view treasure() {
    located(thing, room)
    value(thing, coins)
    named(room, name)
    yield name, sum(coins)
}

view world() {
    located(thing, room)
    named(thing, name)
    yield thing, name
}

view folks(viewer) {
    located(viewer, room)
    located(thing, room)
    label(thing, text)
    yield thing, text
}

view acquainted(viewer) {
    knows(viewer, thing)
    named(thing, name)
    yield thing, name
}

// ---- RPG views --------------------------------------------------------------
view jobs() {
    job(which, name)
    yield which, name
}

view current_job(player) {
    active_job(player, which)
    job(which, name)
    job_rank(player, which, rank)
    job_points(player, which, points)
    job_stats(which, rank, power, guard, max_hp)
    yield which, name, rank, points, power, guard, max_hp
}

view abilities(player) {
    ability_rank(player, which, rank)
    ability(which, name)
    ability_power(which, rank, power)
    yield which, name, rank, power
}

view enemies(viewer) {
    located(viewer, room)
    located(enemy, room)
    monster(enemy)
    named(enemy, name)
    yield enemy, name
}

// Join an unlocked ability to a monster in the player's room. This must be a
// view rather than sequential `find monster` / `find located`: `find` binds the
// least global monster and does not backtrack when that monster is elsewhere.
view ability_targets(player) {
    ability_rank(player, which, rank)
    ability(which, name)
    ability_power(which, rank, power)
    located(player, room)
    located(enemy, room)
    monster(enemy)
    yield which, name, rank, power, enemy
}

// ---- card scoring views -----------------------------------------------------
view crib_pairs(who) {
    slotpair(i, j)
    card(who, i, c1)
    card(who, j, c2)
    cardrank(c1, rank)
    cardrank(c2, rank)
    yield i, j
}

view crib_fif2(who) {
    slotpair(i, j)
    card(who, i, c1)
    card(who, j, c2)
    cardval(c1, a)
    cardval(c2, b)
    sum15two(a, b)
    yield i, j
}

view crib_fif3(who) {
    slottrio(i, j, k)
    card(who, i, c1)
    card(who, j, c2)
    card(who, k, c3)
    cardval(c1, a)
    cardval(c2, b)
    cardval(c3, c)
    sum15three(a, b, c)
    yield i, j, k
}

// ---- textual command grammar -----------------------------------------------
form command {
    "take" noun   -> Take(noun)
    "drop" noun   -> Drop(noun)
    "go" way      -> Go(way)
    "say" message -> Say(message)
    "greet" who   -> Greet(who)
    "change" job  -> Change(job)
    "attack" who  -> Attack(who)
    "use" skill   -> Use(skill)
    "omen"         -> Omen()
}

form patrol_command { "start-patrol" -> StartPatrol() "tick" -> Tick() }
form combat_command { "combat-step" -> CombatStep() }

// ---- behaviors: guarded patches over the relations above -------------------
on inbox parse command {
    match Take(noun) {
        resolve here(self) where name ~ noun
        find located(thing, room)
        expect located(thing, room)
        retract located(thing, room)
        assert held(self, thing)
        emit tell(self, "Taken.")
    }

    match Drop(noun) {
        resolve inventory(self) where name ~ noun
        find located(self, room)
        expect held(self, thing)
        retract held(self, thing)
        assert located(thing, room)
        emit tell(self, "Dropped.")
    }

    match Go(direction) {
        find located(self, room)
        resolve ways(self) where way = direction
        expect located(self, room)
        retract located(self, room)
        assert located(self, destination)
        emit tell(self, "You go.")
    }

    match Say(message) {
        emit tell(self, message)
    }

    match Greet(who) {
        resolve folks(self) where text ~ who
        find named(thing, name)
        assert knows(self, thing)
        assert knows(thing, self)
        emit tell(self, name)
    }

    // The relation lookup is also the location gate: outside the cooperative
    // office `find job_clock(room)` aborts the arm without changing anything.
    match Change(wanted) {
        find located(self, room)
        find job_clock(room)
        resolve jobs() where name ~ wanted
        find active_job(self, old_job)
        expect active_job(self, old_job)
        retract active_job(self, old_job)
        assert active_job(self, which)
        emit tell(self, "Job changed.")
    }

    match Attack(who) {
        resolve enemies(self) where name ~ who
        find active_job(self, job)
        find job_rank(self, job, rank)
        find job_stats(job, rank, power, player_guard, max_hp)
        find hp(enemy, old_hp)
        find defense(enemy, enemy_guard)
        let damage = max(1, power - enemy_guard / 2)
        let new_hp = max(0, old_hp - damage)
        if new_hp == 0 {
            expect hp(enemy, old_hp)
            retract hp(enemy, old_hp)
            assert hp(enemy, new_hp)
            assert combat_event(self, enemy, "defeated")
            schedule world_clock at 0 send CombatStep() to COMBAT
        } else {
            expect hp(enemy, old_hp)
            retract hp(enemy, old_hp)
            assert hp(enemy, new_hp)
            assert combat_event(self, enemy, "standing")
            schedule world_clock at 0 send CombatStep() to COMBAT
        }
        emit tell(self, "You strike.")
    }

    match Use(wanted) {
        resolve ability_targets(self) where name ~ wanted
        find hp(enemy, old_hp)
        find defense(enemy, enemy_guard)
        let damage = max(1, power - enemy_guard / 2)
        let new_hp = max(0, old_hp - damage)
        if new_hp == 0 {
            expect hp(enemy, old_hp)
            retract hp(enemy, old_hp)
            assert hp(enemy, new_hp)
            assert combat_event(self, enemy, "defeated")
            schedule world_clock at 0 send CombatStep() to COMBAT
        } else {
            expect hp(enemy, old_hp)
            retract hp(enemy, old_hp)
            assert hp(enemy, new_hp)
            assert combat_event(self, enemy, "standing")
            schedule world_clock at 0 send CombatStep() to COMBAT
        }
        emit tell(self, "Ability used.")
    }

    match Omen() {
        random omens below 100 as roll
        if roll < 15 {
            emit tell(self, "The arcade lights flicker in warning.")
        } else {
            emit tell(self, "The arcade hums steadily.")
        }
    }

}

on patrol_inbox parse patrol_command {
    match StartPatrol() {
        find patrol_due(self, due)
        schedule world_clock at due send Tick() to CAT
    }

    match Tick() {
        find located(self, room)
        find patrol(room, destination)
        find patrol_due(self, due)
        let next_due = due + 1000
        expect located(self, room)
        expect patrol_due(self, due)
        retract located(self, room)
        retract patrol_due(self, due)
        assert located(self, destination)
        assert patrol_due(self, next_due)
        schedule world_clock at next_due send Tick() to CAT
    }

}

on combat_inbox parse combat_command {
    match CombatStep() {
        find combat_event(player, enemy, outcome)
        expect combat_event(player, enemy, outcome)
        retract combat_event(player, enemy, outcome)
        find combat_claimed(enemy, claimed)
        if claimed {
            emit tell(player, "That victory was already resolved.")
        } else {
          if outcome == "defeated" {
            find monster_reward(enemy, reward)
            find active_job(player, job)
            find job_rank(player, job, rank)
            find job_points(player, job, points)
            find job_progression(job, rank, points, reward, new_rank, new_points, ability, old_ability_rank, new_ability_rank)
            find ability_rank(player, ability, old_ability_rank)
            find boss_unlock(enemy, boss, vault, chamber)
            expect monster_reward(enemy, reward)
            expect combat_claimed(enemy, false)
            expect job_rank(player, job, rank)
            expect job_points(player, job, points)
            expect ability_rank(player, ability, old_ability_rank)
            retract monster_reward(enemy, reward)
            retract combat_claimed(enemy, false)
            retract job_rank(player, job, rank)
            retract job_points(player, job, points)
            retract ability_rank(player, ability, old_ability_rank)
            assert job_rank(player, job, new_rank)
            assert job_points(player, job, new_points)
            assert ability_rank(player, ability, new_ability_rank)
            assert defeated(enemy)
            assert combat_claimed(enemy, true)
            if boss {
                assert exits(vault, "east", chamber)
                assert exits(chamber, "west", vault)
            }
            emit tell(player, "Victory resolved.")
        } else {
            find monster_power(enemy, power)
            find active_job(player, job)
            find job_rank(player, job, rank)
            find job_stats(job, rank, player_power, guard, max_hp)
            find hp(player, old_hp)
            let damage = max(1, power - guard / 2)
            let new_hp = max(0, old_hp - damage)
            expect hp(player, old_hp)
            retract hp(player, old_hp)
            assert hp(player, new_hp)
            if new_hp == 0 {
                assert player_defeat(player)
            }
            emit tell(player, "The monster strikes back.")
          }
        }
    }
}

